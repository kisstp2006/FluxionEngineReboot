{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows (MSVC, Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "codeblocks-mingw-debug",
            "displayName": "Code::Blocks project (MinGW GCC, Debug)",
            "generator": "CodeBlocks - Ninja",
            "binaryDir": "${sourceDir}/build/codeblocks-mingw-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "C:/Program Files/CodeBlocks/MinGW/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/CodeBlocks/MinGW/bin/g++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "codeblocks-mingw-release",
            "displayName": "Code::Blocks project (MinGW GCC, Release)",
            "generator": "CodeBlocks - Ninja",
            "binaryDir": "${sourceDir}/build/codeblocks-mingw-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "C:/Program Files/CodeBlocks/MinGW/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/CodeBlocks/MinGW/bin/g++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux (GCC, via WSL)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux (GCC, via WSL, Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-gcc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-aarch64",
            "displayName": "Linux AArch64 (cross-compiled)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-aarch64",
            "toolchainFile": "${sourceDir}/CMake/Toolchains/Linux-AArch64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FLUXION_BUILD_SAMPLES": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android ARM64 (cross-compiled, NDK)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/android-arm64",
            "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "FLUXION_BUILD_SAMPLES": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "codeblocks-mingw-debug",
            "configurePreset": "codeblocks-mingw-debug"
        },
        {
            "name": "codeblocks-mingw-release",
            "configurePreset": "codeblocks-mingw-release"
        },
        {
            "name": "linux-gcc",
            "configurePreset": "linux-gcc"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release"
        },
        {
            "name": "linux-aarch64",
            "configurePreset": "linux-aarch64"
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64"
        }
    ],
    "testPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "codeblocks-mingw-debug",
            "configurePreset": "codeblocks-mingw-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc",
            "configurePreset": "linux-gcc",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
