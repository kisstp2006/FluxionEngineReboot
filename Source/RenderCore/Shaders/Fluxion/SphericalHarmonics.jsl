#ifndef FLUXION_SPHERICAL_HARMONICS_INCLUDED
#define FLUXION_SPHERICAL_HARMONICS_INCLUDED

#include "Fluxion/Frame.jsl"
#include "Fluxion/Math.jsl"

// Describing a whole sky with nine numbers per colour channel.
//
// A diffuse surface sees the sky through a cosine lobe so broad that all
// sharp detail is smoothed away before it has any effect -- so the sky is
// kept as the first three spherical-harmonic bands, and evaluation costs
// nine multiply-adds instead of a texture read. What is lost is detail
// the surface was never going to show.
//
// Written from the published description, not from anyone's code; see
// SHADER_SOURCES.md. The nine terms are written out (this language has
// no arrays), one line per basis function.

#define FLUXION_SH_COEFFICIENT_COUNT 9

// The irradiance arriving on a surface facing this way.
//
// The coefficients come from the frame's own buffer, worked out once when
// the environment was loaded. They are ALREADY CONVOLVED with the cosine
// lobe -- what turns light arriving from every direction into light
// falling on a surface -- so this is a plain weighted sum rather than an
// integral, and what comes out is irradiance in the same units as every
// light in the scene.
//
// `normal` must be a unit vector: every basis function below is a
// polynomial in its components that is only correct on the unit sphere.
Vector3 Fluxion_SH_Irradiance(Vector3 normal)
{
    float x = normal.x;
    float y = normal.y;
    float z = normal.z;

    // Band 0: constant, the average of the sky. On its own this is the
    // flat ambient that used to stand in for all of it.
    Vector3 irradiance = irradianceSH[0].xyz * 0.282095;

    // Band 1: linear, which side the light comes from. This is the band
    // that makes an upward-facing surface brighter than a downward-facing
    // one under a sky, and it is the one a flat ambient cannot express at
    // all.
    irradiance = irradiance + irradianceSH[1].xyz * (0.488603 * y);
    irradiance = irradiance + irradianceSH[2].xyz * (0.488603 * z);
    irradiance = irradiance + irradianceSH[3].xyz * (0.488603 * x);

    // Band 2: quadratic. Enough to tell a bright band around the horizon
    // from a bright patch overhead, which is the difference between an
    // outdoor sky and a room with a skylight.
    irradiance = irradiance + irradianceSH[4].xyz * (1.092548 * x * y);
    irradiance = irradiance + irradianceSH[5].xyz * (1.092548 * y * z);
    irradiance = irradiance + irradianceSH[6].xyz * (0.315392 * (3.0 * z * z - 1.0));
    irradiance = irradiance + irradianceSH[7].xyz * (1.092548 * x * z);
    irradiance = irradiance + irradianceSH[8].xyz * (0.546274 * (x * x - y * y));

    // A sum of signed functions can land below zero in directions the sky
    // it was fitted to never was. Light arriving in a negative amount is
    // not a thing, and left alone it shows as black rims on the surfaces
    // facing away from the bright part of the sky -- which reads as a
    // shading bug rather than as the fit running out of bands.
    return max(irradiance, Vector3(0.0, 0.0, 0.0));
}

#endif
