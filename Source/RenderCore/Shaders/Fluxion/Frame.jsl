#ifndef FLUXION_FRAME_INCLUDED
#define FLUXION_FRAME_INCLUDED

// What is the same for every object drawn in one frame of one view.
//
// The engine WRITES these into a buffer whose layout it decides, so this
// declaration and FluxionFrameConstants in RenderView.h must agree field
// for field -- drift reads a matrix from the wrong offset. New fields go
// at the END of both. Every entry is four components wide even where
// three would do: a uniform block rounds vec3 up to four anyway, and
// writing the padding down keeps packing rules out of it.

[Uniform(Frame)] Matrix4x4 viewProjection;

// xyz: where the eye is, in world space.
[Uniform(Frame)] Vector4 cameraPosition;

// Undoes the one above. Turning a point on the screen back into a
// direction in the world is the whole of drawing a sky, and there is no
// way to get there from the forward matrix alone.
[Uniform(Frame)] Matrix4x4 inverseViewProjection;

// rgb: a flat amount arriving from every direction, standing in for the
// sky until there is one.
//
// w: how much the environment map counts for -- what is seen of it
// directly and, once there is any, what it casts. It sits here rather
// than in a field of its own because it is what the rgb above turns into:
// when the sky becomes a real light source, this is the number that
// survives and those are the ones that go.
[Uniform(Frame)] Vector4 ambientColor;

// x: how many lights the list below holds. y: how many shadows. zw unused.
//
// A count rather than a terminator: a shader cannot ask a buffer how long
// it is on every backend, and a loop that ran until it found a zeroed
// light would stop at the first one somebody switched off.
[Uniform(Frame)] Vector4 lightParams;

// x: the exposure multiplier -- how much light makes a middle grey.
// y: the tone mapping white point, the value that comes out as exactly
//    one. Zero or less means the pass does not tone map at all.
// z: one if the colour target wants the display's transfer function
//    applied here, zero if it applies its own.
// w: unused.
[Uniform(Frame)] Vector4 toneMapping;

// x: how wide one texel of the shadow atlas is, in atlas coordinates.
//
// yz: the atlas's second coordinate, as a scale and an offset applied
// after a tile's rectangle. Every shadow rectangle in this engine counts
// rows DOWNWARDS from the top, which is how the shadow pass's viewport
// places them; one backend then reads its texture rows the other way up,
// and this pair is the single place that difference is written down --
// (1, 0) where the two agree, (-1, 1) where they do not.
//
// w: unused.
[Uniform(Frame)] Vector4 shadowAtlasParams;

// One light, packed.
//
// Four vectors of four, with everything folded into their components by
// hand, because the two languages this compiles to do not lay out a
// structure the same way when it mixes three-component vectors with
// single floats. Four-component vectors are the one shape both agree on
// without a rule anybody has to remember -- and a layout the two ends
// disagreed about would not fail, it would read the right memory in the
// wrong pieces.
struct FluxionLight
{
    // xyz: where it is, in world space. w: where its contribution reaches
    // zero. Neither means anything to a directional light.
    Vector4 positionRange;

    // xyz: THE WAY THE LIGHT TRAVELS, not the way to the light. One
    // convention, chosen because it is the one a cone is measured around.
    // w: which kind it is -- 0 directional, 1 point, 2 spot.
    Vector4 direction;

    // rgb: colour and intensity together. w: the cosine of the inner cone
    // angle, already taken on the other side, because a cosine per pixel
    // per light is not free and the angle is never wanted for anything.
    Vector4 color;

    // x: the cosine of the outer cone angle. yzw spare.
    Vector4 cone;
};

// What the world looks like in every direction.
//
// One texture at frame frequency rather than one per material: every
// surface in a frame is surrounded by the same world, and a copy per
// material would be the same texture bound many times over.
//
// A view that was given no environment still has one -- a small black
// cube the engine keeps -- so this is never an empty binding. A shader
// cannot ask whether a texture is there, and a backend that was handed
// nothing would refuse the whole bind group rather than the one slot.
[Texture(Frame)] TextureCube environmentMap;

// The same world pre-blurred for rough reflections: each mip holds the
// environment as a mirror of one roughness sees it, mip zero sharp and
// the last mip fully diffuse. Written by a compute pass when the
// environment changes; a view that has no environment holds a black one
// here for the same reason as above.
[Texture(Frame)] TextureCube prefilteredMap;

// How many mips the chain above holds. The engine allocates the texture
// from the same number -- FLUXION_RENDERER_PREFILTERED_MIPS in
// RendererInternal.h -- and the two must agree, because this is what
// turns a roughness into a mip level.
#define FLUXION_PREFILTERED_MIP_COUNT 8.0

// The split-sum environment integral's other half: for a viewing angle
// and a roughness, a scale and a bias on the head-on reflectance. Filled
// by a compute pass once per view, from nothing -- it depends on no sky.
[Texture(Frame)] Texture2D dfgTable;

// Every shadow in the frame, in one depth texture cut into tiles.
//
// Read through a comparison sampler, so what comes back is not a depth
// but an answer: how much of the light got here. The hardware does the
// comparison as part of the fetch, which is what lets it filter the
// ANSWERS rather than the depths -- averaging depths across a shadow's
// edge gives a number no surface was ever at.
[Texture(Frame)] Texture2DShadow shadowAtlas;

// One shadow: where its light looks from, and where in the atlas the
// answer lives.
//
// Rows rather than a matrix, and everything else in fours, for the same
// reason FluxionLight is packed by hand: four-component vectors are the
// one shape both shading languages lay out identically.
struct FluxionShadow
{
    // The light's view-projection, a row at a time.
    Vector4 lightRow0;
    Vector4 lightRow1;
    Vector4 lightRow2;
    Vector4 lightRow3;

    // xy the corner, zw the size, in atlas coordinates counting rows
    // downwards -- see shadowAtlasParams above.
    Vector4 atlasRect;

    // x: which light in the list above this belongs to.
    // y: how far from the eye it is the one to read, so that a light's
    //    shadows can be ordered near to far and each cover its own share.
    // z: how wide the handover to the next one is at that far edge. Zero
    //    means a hard change, which is visible as a line across the floor.
    // w: how this light's shadows are chosen -- zero by how far the eye
    //    is, one by which way the surface lies from the light. The first
    //    is a set of cascades, the second the six faces of a cube.
    Vector4 range;

    // x: how far along the light's own axis to move the comparison, and
    // y: how far along the surface normal to move the point looked up.
    // Both undo the same thing from different sides: a depth recorded at
    // one resolution, tested against a surface sampled at another, has a
    // surface shadowing itself in stripes. zw unused.
    Vector4 bias;
};

// The lights this frame is lit by.
//
// A buffer rather than an array in the block above: an array would need a
// maximum written into the shader, and a maximum is a number somebody has
// to raise -- while costing every frame that does not use it, because a
// uniform block is paid for whether it is full or not.
[Buffer(Frame)] FluxionLight lights;

// The sky, as nine numbers per colour channel.
//
// A buffer rather than more fields in the block above, and for a reason
// that is about where they come from rather than how many there are: they
// are worked out ON THE GPU when an environment is loaded, and a buffer is
// something a compute pass can write into directly. Putting them in the
// uniform block would mean reading them back to the processor and sending
// them out again every frame, to arrive at the numbers that were already
// there.
//
// Already convolved with the cosine lobe -- see SphericalHarmonics.jsl --
// so what a surface reads out of these is irradiance, in the same units as
// every light in the scene.
[Buffer(Frame)] Vector4 irradianceSH;

// The shadows this frame holds, one light's cascades next to each other
// and ordered near to far. A buffer for the same reason the lights are
// one: what a scene needs is a budget rather than a number compiled in.
[Buffer(Frame)] FluxionShadow shadows;

#endif
