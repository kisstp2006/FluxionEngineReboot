#ifndef FLUXION_FRAME_INCLUDED
#define FLUXION_FRAME_INCLUDED

// What is the same for every object drawn in one frame of one view.
//
// Declared here and nowhere else. These are not a material's parameters,
// which the engine reads back from whatever a shader happens to declare:
// the engine WRITES these, into a buffer whose layout it decides, so the
// declaration and the struct that fills it have to agree exactly. Two
// copies of that agreement is one too many, and the failure when they
// drift is a matrix read from the wrong offset -- geometry in the wrong
// place, or nothing on the screen at all.
//
// The order matches FluxionFrameConstants in RenderView.h, field for
// field. A field is added at the END of both, so that a shader declaring
// only the first of them still reads the right bytes.
//
// Every entry is four components wide even where three would do, because
// a uniform block rounds a three-component value up to four regardless --
// writing the padding down means no backend's packing rules get to decide
// where the next field begins.

[Uniform(Frame)] Matrix4x4 viewProjection;

// xyz: where the eye is, in world space.
[Uniform(Frame)] Vector4 cameraPosition;

// Undoes the one above. Turning a point on the screen back into a
// direction in the world is the whole of drawing a sky, and there is no
// way to get there from the forward matrix alone.
[Uniform(Frame)] Matrix4x4 inverseViewProjection;

// rgb: a flat amount arriving from every direction, standing in for the
// sky until there is one.
[Uniform(Frame)] Vector4 ambientColor;

// x: how many lights the list below holds. yzw unused.
//
// A count rather than a terminator: a shader cannot ask a buffer how long
// it is on every backend, and a loop that ran until it found a zeroed
// light would stop at the first one somebody switched off.
[Uniform(Frame)] Vector4 lightParams;

// x: the exposure multiplier -- how much light makes a middle grey.
// y: the tone mapping white point, the value that comes out as exactly
//    one. Zero or less means the pass does not tone map at all.
// z: one if the colour target wants the display's transfer function
//    applied here, zero if it applies its own.
// w: unused.
[Uniform(Frame)] Vector4 toneMapping;

// One light, packed.
//
// Four vectors of four, with everything folded into their components by
// hand, because the two languages this compiles to do not lay out a
// structure the same way when it mixes three-component vectors with
// single floats. Four-component vectors are the one shape both agree on
// without a rule anybody has to remember -- and a layout the two ends
// disagreed about would not fail, it would read the right memory in the
// wrong pieces.
struct FluxionLight
{
    // xyz: where it is, in world space. w: where its contribution reaches
    // zero. Neither means anything to a directional light.
    Vector4 positionRange;

    // xyz: THE WAY THE LIGHT TRAVELS, not the way to the light. One
    // convention, chosen because it is the one a cone is measured around.
    // w: which kind it is -- 0 directional, 1 point, 2 spot.
    Vector4 direction;

    // rgb: colour and intensity together. w: the cosine of the inner cone
    // angle, already taken on the other side, because a cosine per pixel
    // per light is not free and the angle is never wanted for anything.
    Vector4 color;

    // x: the cosine of the outer cone angle. yzw spare.
    Vector4 cone;
};

// What the world looks like in every direction.
//
// One texture at frame frequency rather than one per material: every
// surface in a frame is surrounded by the same world, and a copy per
// material would be the same texture bound many times over.
//
// A view that was given no environment still has one -- a small black
// cube the engine keeps -- so this is never an empty binding. A shader
// cannot ask whether a texture is there, and a backend that was handed
// nothing would refuse the whole bind group rather than the one slot.
[Texture(Frame)] TextureCube environmentMap;

// The lights this frame is lit by.
//
// A buffer rather than an array in the block above: an array would need a
// maximum written into the shader, and a maximum is a number somebody has
// to raise -- while costing every frame that does not use it, because a
// uniform block is paid for whether it is full or not.
[Buffer(Frame)] FluxionLight lights;

#endif
