#ifndef FLUXION_LIGHTING_INCLUDED
#define FLUXION_LIGHTING_INCLUDED

#include "Fluxion/BRDF.jsl"
#include "Fluxion/Frame.jsl"
#include "Fluxion/SphericalHarmonics.jsl"

// What actually reaches the eye from a surface.
//
// BRDF.jsl answers "of the light arriving from there, how much leaves
// towards here"; this file answers how much arrives, and from where. Two
// files because they change for different reasons: a new kind of light
// touches this one, a better reflectance model the other.

// One directional light -- the sun, far enough away that its direction
// is one vector for the whole scene.
//
// The incidence cosine is applied HERE rather than inside the
// reflectance model: it is a property of the geometry, and a second
// light would otherwise apply it a second time.
Vector3 EvaluateDirectionalLight(SurfaceData surface, Vector3 N, Vector3 V, Vector3 L, Vector3 lightColor,
                                 Vector3 energyCompensation)
{
    float NoL = Saturate(dot(N, L));

    // Nothing at all rather than nearly nothing. A surface turned away
    // from the light receives none of it, and the reflectance model
    // divides by quantities that go to zero along with this one.
    if (NoL <= 0.0)
    {
        return Vector3(0.0, 0.0, 0.0);
    }

    return BRDF_Direct(surface, N, V, L, energyCompensation) * lightColor * NoL;
}

// How much of a light reaches something this far away.
//
// Inverse square, times a window reaching exactly zero at the range --
// which is what makes many lights affordable, since a light dropped
// while still contributing leaves a moving edge. The square-of-a-square
// shape is the published one.
float DistanceAttenuation(float distanceSquared, float range)
{
    float attenuation = 1.0 / max(distanceSquared, FLUXION_EPSILON);

    if (range <= 0.0)
    {
        return attenuation;
    }

    float ratio = distanceSquared / max(Square(range), FLUXION_EPSILON);
    float window = Saturate(1.0 - Square(ratio));
    return attenuation * Square(window);
}

// How much of a spot light reaches something this far off its axis.
//
// One inside the inner cone, zero outside the outer, and smooth between.
// Smoothed rather than linear because a straight ramp leaves a visible
// crease where it meets full brightness -- the eye finds the break in the
// slope, not the break in the value.
float SpotAttenuation(Vector3 lightDirection, Vector3 toSurface, float innerCos, float outerCos)
{
    float cosAngle = dot(lightDirection, toSurface);
    float span = max(innerCos - outerCos, FLUXION_EPSILON);
    float t = Saturate((cosAngle - outerCos) / span);
    return Square(t) * (3.0 - 2.0 * t);
}

// How far the filter reaches from its centre, in texels, and how many
// taps that is. The bias has to cover the depth across the whole
// footprint the comparison reads, so these belong to it as much as to
// the filter.
#define FLUXION_SHADOW_FILTER_REACH 1.0
#define FLUXION_SHADOW_FILTER_TAPS 9.0

// How much of one shadow's light reaches this point. One means all of
// it, which is also what a point outside the map gets: nothing was
// recorded there, and guessing dark would put a black slab wherever a
// shadow map ends. `NoL` is the cosine to the light -- see the bias.
float ShadowFactor(FluxionShadow shadow, Vector3 P, Vector3 N, float NoL)
{
    // Moved out of the surface before the lookup: the depth was recorded
    // at the atlas's resolution and is tested against a surface sampled
    // at the screen's, and that disagreement otherwise reads as the
    // surface shadowing itself.
    Vector3 offsetP = P + N * shadow.bias.y;
    Vector4 p = Vector4(offsetP.x, offsetP.y, offsetP.z, 1.0);

    Vector4 clip = Vector4(dot(shadow.lightRow0, p), dot(shadow.lightRow1, p),
                           dot(shadow.lightRow2, p), dot(shadow.lightRow3, p));

    // Behind the light. A perspective divide by this would fold the point
    // round to somewhere in front, where it would shadow something real.
    if (clip.w <= 0.0)
    {
        return 1.0;
    }

    Vector3 ndc = clip.xyz / clip.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 || ndc.z > 1.0)
    {
        return 1.0;
    }

    // Clip space counts its second axis up the picture and a shadow
    // rectangle counts rows down it, so the two are opposite here. What
    // that rectangle then means on the device is shadowAtlasParams' job.
    float u = ndc.x * 0.5 + 0.5;
    float v = 0.5 - ndc.y * 0.5;

    float centreU = shadow.atlasRect.x + u * shadow.atlasRect.z;
    float centreV = shadow.atlasRect.y + v * shadow.atlasRect.w;

    // Pulled towards the light before the comparison, for the other half
    // of the same disagreement the normal offset above addresses.
    //
    // SCALED BY THE SURFACE'S SLOPE, because no fixed amount suits two
    // surfaces at different angles: one edge-on to the light crosses
    // many texels' worth of depth within a single texel, one facing it
    // almost none. The tangent of the incidence angle is that ratio,
    // bounded because it runs away at grazing angles.
    //
    // Times the filter's reach too -- the comparison reads a footprint,
    // not a texel, and its far side is where a lit surface would
    // otherwise shadow itself.
    float slope = sqrt(max(1.0 - NoL * NoL, 0.0)) / max(NoL, 0.05);
    float boundedSlope = min(slope, 8.0);
    float reference = ndc.z - shadow.bias.x * (1.0 + boundedSlope) * (1.0 + FLUXION_SHADOW_FILTER_REACH);

    float texel = shadowAtlasParams.x;

    // HOW FAR A TAP MAY WANDER AND STILL BE THIS LIGHT'S SHADOW. Every
    // shadow shares one texture, so a tap past the tile's edge reads the
    // NEXT LIGHT'S map, not this one's edge. Half a texel inside is
    // where a bilinear read stops reaching over.
    float halfTexel = texel * 0.5;
    float lowU = shadow.atlasRect.x + halfTexel;
    float highU = shadow.atlasRect.x + shadow.atlasRect.z - halfTexel;
    float lowV = shadow.atlasRect.y + halfTexel;
    float highV = shadow.atlasRect.y + shadow.atlasRect.w - halfTexel;

    // Nine comparisons a texel apart, averaged.
    //
    // THE ANSWERS ARE FILTERED, NOT THE DEPTHS -- the whole published
    // idea, and why the sampler does the comparing. An average of depths
    // is a number no surface was at; an average of "did the light reach
    // me" is how much of it did. Each tap is already the hardware's own
    // average of four texels, so three by three covers four by four.
    float sum = 0.0;
    for (int y = -1; y <= 1; y = y + 1)
    {
        for (int x = -1; x <= 1; x = x + 1)
        {
            float tapU = min(max(centreU + float(x) * texel, lowU), highU);
            float tapV = min(max(centreV + float(y) * texel, lowV), highV);

            // To the device's own way up, last, so everything above is
            // in the one convention this engine states its rectangles in.
            tapV = shadowAtlasParams.y * tapV + shadowAtlasParams.z;

            sum = sum + textureCompare(shadowAtlas, Vector2(tapU, tapV), reference);
        }
    }

    return sum / FLUXION_SHADOW_FILTER_TAPS;
}

// Which of a cube's six maps a direction falls in.
//
// Largest component for the axis, its sign for the end -- the order
// Fluxion_ShadowMatrices_PointFace builds them in: +X, -X, +Y, -Y, +Z,
// -Z. A different order reads a real depth from the wrong direction,
// which is a shadow in the wrong place rather than no shadow.
int CubeFaceOf(Vector3 direction)
{
    Vector3 size = abs(direction);

    if (size.x >= size.y && size.x >= size.z)
    {
        if (direction.x > 0.0) { return 0; }
        return 1;
    }

    if (size.y >= size.z)
    {
        if (direction.y > 0.0) { return 2; }
        return 3;
    }

    if (direction.z > 0.0) { return 4; }
    return 5;
}

// How much of one light reaches this point, across all of its shadows.
//
// A light may have several, next to each other in the list, and there are
// two reasons it might: the sun's cascades, each covering a share of the
// distance from the eye at its own resolution, or a point light's six
// faces, which cover directions rather than distances. Which of the two
// this light is comes from the record itself.
float EvaluateShadow(int lightIndex, Vector3 P, Vector3 N, float NoL, Vector3 lightPosition, float viewDistance)
{
    int shadowCount = int(lightParams.y);

    // Walked backwards with the last match kept, so this ends up at the
    // LOWEST index belonging to this light -- the nearest cascade, or the
    // first face of the cube.
    int first = -1;
    for (int i = shadowCount - 1; i >= 0; i = i - 1)
    {
        if (int(shadows[i].range.x) == lightIndex)
        {
            first = i;
        }
    }

    if (first < 0)
    {
        return 1.0;
    }

    // A point light shines every way at once, so nothing about the eye
    // decides which of its maps to read -- only where the surface is.
    // The distance still matters for whether to read one at all: past
    // what the light was given, it casts nothing.
    if (shadows[first].range.w > 0.5)
    {
        if (viewDistance > shadows[first].range.y)
        {
            return 1.0;
        }

        int face = CubeFaceOf(P - lightPosition);
        return ShadowFactor(shadows[first + face], P, N, NoL);
    }

    // Cascades: the nearest one that reaches this far is the sharpest
    // that has anything to say about the point.
    int chosen = -1;
    for (int i = shadowCount - 1; i >= 0; i = i - 1)
    {
        if (int(shadows[i].range.x) == lightIndex && viewDistance <= shadows[i].range.y)
        {
            chosen = i;
        }
    }

    // Past the last cascade, or a light that casts nothing.
    if (chosen < 0)
    {
        return 1.0;
    }

    float factor = ShadowFactor(shadows[chosen], P, N, NoL);

    // Two cascades meeting at a hard line is the thing a viewer notices
    // about cascades at all, because the two sides of it are shadows of
    // different sharpness. Handed over across a band instead, if this one
    // was given a band and there is another of the same light after it.
    float band = shadows[chosen].range.z;
    int next = chosen + 1;
    if (band > 0.0 && next < shadowCount && int(shadows[next].range.x) == lightIndex)
    {
        float handover = Saturate((viewDistance - (shadows[chosen].range.y - band)) / band);
        factor = factor + (ShadowFactor(shadows[next], P, N, NoL) - factor) * handover;
    }

    return factor;
}

// What one light of any kind sends towards the eye from this point.
Vector3 EvaluateOneLight(SurfaceData surface, Vector3 N, Vector3 V, Vector3 P, FluxionLight light,
                         int lightIndex, float viewDistance, Vector3 energyCompensation)
{
    // The way the light travels, and the way back towards it. The
    // reflectance model wants the second; the cone below wants the first.
    Vector3 travel = light.direction.xyz;
    Vector3 L = -travel;

    float attenuation = 1.0;

    // 0.5 rather than 0: the kind is carried as a float in a vector, and
    // comparing floats for equality is how a value that survived a
    // round trip through a buffer stops matching itself.
    if (light.direction.w > 0.5)
    {
        Vector3 offset = light.positionRange.xyz - P;
        float distanceSquared = dot(offset, offset);

        L = offset / max(sqrt(distanceSquared), FLUXION_EPSILON);
        attenuation = DistanceAttenuation(distanceSquared, light.positionRange.w);

        // A spot is a point light with a cone over it, so this is the
        // point light's work plus one more term.
        if (light.direction.w > 1.5)
        {
            attenuation = attenuation * SpotAttenuation(travel, -L, light.color.w, light.cone.x);
        }
    }

    if (attenuation <= 0.0)
    {
        return Vector3(0.0, 0.0, 0.0);
    }

    // Asked after the falloff and before the reflectance: a light that
    // does not reach here needs no shadow looked up, and one that is
    // fully blocked needs no reflectance worked out.
    //
    // The cosine goes with it because the depth offset depends on it --
    // a surface edge-on to the light needs a far larger one than a
    // surface facing it. Worked out here rather than inside, where the
    // way back to the light is no longer a thing that exists.
    float shadowNoL = Saturate(dot(N, L));
    float shadow = EvaluateShadow(lightIndex, P, N, shadowNoL, light.positionRange.xyz, viewDistance);
    if (shadow <= 0.0)
    {
        return Vector3(0.0, 0.0, 0.0);
    }

    return EvaluateDirectionalLight(surface, N, V, L, light.color.xyz * attenuation, energyCompensation) * shadow;
}

// What the surroundings send to this surface.
//
// The nine coefficients describe the whole sky, so this reads a different
// amount depending on which way the surface faces -- which is the thing a
// flat ambient could not do at all. A surface turned up towards a bright
// sky is lit; the same surface turned down is not.
//
// The SAME diffuse reflectance as the direct lights use. What comes out
// of the coefficients is irradiance -- light falling on the surface -- and
// turning that into light leaving it is the reflectance model's job, not
// this file's. Applying anything else here would make a surface answer
// differently to the sun and to the sky, which is the one thing that
// makes an image look assembled rather than lit.
Vector3 EvaluateAmbient(SurfaceData surface, Vector3 ambient)
{
    return ComputeDiffuseColor(surface) * ambient * surface.ambientOcclusion;
}

// The whole environment at once -- reflection and skylight together,
// because energy lost by one is returned through the other. The
// prefiltered chain answers "what does the mirror cone see", the DFG
// table "how much of that this surface keeps", and what no specular
// path claimed is exactly what the diffuse share gets -- so a white
// surface under a uniform sky returns the sky, at every roughness.
Vector3 EvaluateEnvironment(SurfaceData surface, Vector3 N, Vector3 V)
{
    float NoV = max(abs(dot(N, V)), FLUXION_EPSILON);
    float roughness = surface.perceptualRoughness;

    Vector3 R = reflect(-V, N);
    Vector3 reflection = textureLod(prefilteredMap, R, roughness * (FLUXION_PREFILTERED_MIP_COUNT - 1.0)).xyz;

    // The irradiance divided by pi: the same quantity Lambert hands
    // back, which is the units the terms below are stated in.
    Vector3 skylight = Fluxion_SH_Irradiance(N) * FLUXION_INV_PI;

    Vector2 dfg = textureLod(dfgTable, Vector2(NoV, roughness), 0.0).xy;
    Vector3 f0 = ComputeF0(surface);

    // Single scattering: what leaves after one bounce off the surface.
    Vector3 singleScatter = f0 * dfg.x + Vector3(dfg.y, dfg.y, dfg.y);

    // What one bounce failed to send out went back INTO the surface
    // field, to come out after more bounces, tinted by the average
    // reflectance each time. The 1/21 is the closed form of averaging
    // Schlick over the hemisphere.
    float energySeen = dfg.x + dfg.y;
    float energyMissed = 1.0 - energySeen;
    Vector3 averageFresnel = f0 + (Vector3(1.0, 1.0, 1.0) - f0) * (1.0 / 21.0);
    Vector3 multiScatter = averageFresnel * (singleScatter * energyMissed)
                         / (Vector3(1.0, 1.0, 1.0) - averageFresnel * energyMissed);

    // Only what neither scattering path claimed reaches the diffuse
    // interior -- this is where the halves stay honest with each other.
    Vector3 diffuseShare = ComputeDiffuseColor(surface)
                         * (Vector3(1.0, 1.0, 1.0) - singleScatter - multiScatter);

    Vector3 environment = singleScatter * reflection
                        + (multiScatter + diffuseShare) * skylight * surface.ambientOcclusion;
    return environment * ambientColor.w;
}

// The whole of what a surface sends towards the eye, with the frame's own
// light.
//
// N is the surface normal and P its world position; both are what the
// vertex stage interpolated and the material may have changed.
Vector3 EvaluateLighting(SurfaceData surface, Vector3 N, Vector3 P)
{
    Vector3 V = normalize(cameraPosition.xyz - P);

    // The single-scattering loss, undone for every direct light at once:
    // one over the surface's directional reflectance, shaped by f0. Read
    // from the same table the environment uses, at the same angle, so
    // the sun and the sky agree about what the surface keeps.
    float NoV = max(abs(dot(N, V)), FLUXION_EPSILON);
    Vector2 dfg = textureLod(dfgTable, Vector2(NoV, surface.perceptualRoughness), 0.0).xy;
    float reflectedEnergy = max(dfg.x + dfg.y, FLUXION_EPSILON);
    Vector3 energyCompensation = Vector3(1.0, 1.0, 1.0)
                               + ComputeF0(surface) * (1.0 / reflectedEnergy - 1.0);

    Vector3 color = Vector3(0.0, 0.0, 0.0);

    // Every light in the frame's list. No cap here and none in the
    // buffer: what makes many lights affordable is the falloff reaching
    // zero, not a number written into a shader.
    // How far out the point is, which is what picks a cascade. Straight
    // distance from the eye rather than depth along its axis: it needs no
    // second vector in the frame constants, and where the two differ --
    // out at the corners of the view -- it picks the FARTHER cascade,
    // which always covers more than the nearer one would have.
    float viewDistance = length(cameraPosition.xyz - P);

    int lightCount = int(lightParams.x);
    for (int i = 0; i < lightCount; i = i + 1)
    {
        color = color + EvaluateOneLight(surface, N, V, P, lights[i], i, viewDistance, energyCompensation);
    }

    // Two separate sources, not one written twice. The flat ambient is a
    // number somebody set by hand, for a scene with no sky at all; the
    // second is the sky there actually is. A scene that has an environment
    // sets the first to zero -- and one that does not is exactly as it
    // was before any of this existed.
    color = color + EvaluateAmbient(surface, ambientColor.xyz);
    color = color + EvaluateEnvironment(surface, N, V);

    // Light the surface gives off, which no amount of shadow or occlusion
    // takes away -- that is what emitting means.
    color = color + surface.emissive;

    return color;
}

#endif
