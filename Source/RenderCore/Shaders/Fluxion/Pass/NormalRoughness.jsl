#ifndef FLUXION_PASS_NORMAL_ROUGHNESS_INCLUDED
#define FLUXION_PASS_NORMAL_ROUGHNESS_INCLUDED

#include "Fluxion/Surface.jsl"
#include "Fluxion/Varyings.jsl"

// WHICH WAY EVERY PIXEL FACES AND HOW ROUGH IT IS, WRITTEN BEFORE
// ANYTHING IS LIT.
//
// Three later passes need this and none of them can get it from the
// finished picture: occlusion needs to know which way a surface faces to
// know which half of the sky it can see, and a reflection needs both the
// normal to bounce off and the roughness to decide how sharp the bounce
// is.
//
// WHY BEFORE, and not alongside the lighting. Ambient occlusion darkens
// INDIRECT light -- it is a statement about how much of the sky reaches a
// point, not about the picture. For the lighting to use it, it has to
// exist by the time the lighting runs; and it is worked out from depth
// and normals, which therefore have to exist before that. A pass that
// produced them at the same time as the lighting would leave occlusion
// with nothing to do but darken the finished frame, direct light and
// all -- which is wrong, and looks it.
//
// This calls the SAME `EvaluateSurface()` the forward pass calls, so a
// material that computes its surface unusually is described here exactly
// as it will be drawn. That is the whole reason this is built per
// material rather than being one shader the engine owns, the way the
// shadow and motion vector passes are.

[Target(0)] Vector4 fragSurface;

// A NORMAL IN TWO NUMBERS INSTEAD OF THREE.
//
// A unit vector has only two degrees of freedom, so storing three
// components wastes one -- and the obvious two-component scheme (drop Z,
// rebuild it) cannot tell a surface facing towards the camera from one
// facing away, which matters at every silhouette.
//
// The octahedral mapping folds the sphere onto a square instead: the
// upper half maps straight down, the lower half folds outwards. It is
// cheap both ways, has no pole, and spreads its error evenly -- which is
// what makes eight bits a component enough for what reads this.
Vector2 EncodeNormalOctahedral(Vector3 n)
{
  Vector3 unit = n / (abs(n.x) + abs(n.y) + abs(n.z));

  Vector2 folded = Vector2(unit.x, unit.y);
  if (unit.z < 0.0)
  {
    float foldedX = (1.0 - abs(unit.y)) * (unit.x >= 0.0 ? 1.0 : -1.0);
    float foldedY = (1.0 - abs(unit.x)) * (unit.y >= 0.0 ? 1.0 : -1.0);
    folded = Vector2(foldedX, foldedY);
  }

  // Into the range a texture holds. The target is unsigned, and a normal
  // is not.
  return folded * 0.5 + Vector2(0.5, 0.5);
}

void main() {
  SurfaceData surface = EvaluateSurface();

  // The same test the forward pass makes, from the same function, so the
  // two cannot disagree about which pixels exist -- and so the depth this
  // pass leaves behind is the depth the forward pass would have written.
  if (SurfaceFailsAlphaTest(surface))
  {
    discard;
  }

  // Normalized here for the same reason the forward pass normalizes:
  // what arrived is the average of three unit vectors, which is shorter
  // than one. A short normal decodes to a direction that is merely wrong
  // rather than to an obvious fault.
  Vector3 N = normalize(surface.normal);
  Vector2 encoded = EncodeNormalOctahedral(N);

  // PERCEPTUAL ROUGHNESS, the number a material author set -- not the
  // squared one the lighting works in. What reads this is deciding how
  // wide a reflection should be, and the perceptual scale is the one
  // that is even across its range.
  return Vector4(encoded.x, encoded.y, surface.perceptualRoughness, 1.0);
}

#endif
