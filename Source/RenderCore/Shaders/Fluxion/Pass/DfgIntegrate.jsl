#ifndef FLUXION_PASS_DFG_INTEGRATE_INCLUDED
#define FLUXION_PASS_DFG_INTEGRATE_INCLUDED

#include "Fluxion/ImportanceSampling.jsl"

// The environment side of the split-sum approximation: how much of a
// prefiltered environment a surface actually reflects, as a function of
// nothing but viewing angle and roughness. Two numbers per entry -- a
// scale on the head-on reflectance and a bias -- so that at draw time
// the whole integral is `f0 * scale + bias`. Depends on no scene and no
// sky, so it is computed once per device, ever. Maths from the published
// description; see SHADER_SOURCES.md.
[Uniform(Global)] Vector4 dfgParams;
[Buffer(Global)] Vector4 dfgOut;

// dfgParams:
//   x  the table's width and height in texels
//   y  texels from one output row to the next (copy alignment padding)

#define FLUXION_DFG_SAMPLE_COUNT 1024

// The Schlick-GGX geometry term with the roughness remapping the
// published description uses FOR ENVIRONMENT LIGHTING -- the direct
// lighting remapping is different, and mixing them is the standard way
// to get a table that looks plausible and is wrong.
float Fluxion_Dfg_GeometrySchlickGGX(float cosine, float k)
{
    return cosine / (cosine * (1.0 - k) + k);
}

Vector2 Fluxion_Dfg_Integrate(float NoV, float perceptualRoughness)
{
    float alphaRoughness = Square(perceptualRoughness);
    float k = alphaRoughness * 0.5;

    // The view direction reconstructed from its cosine alone -- the
    // integral is symmetric around the normal, so which way it leans
    // does not matter, only how far.
    Vector3 V = Vector3(sqrt(1.0 - NoV * NoV), 0.0, NoV);
    Vector3 N = Vector3(0.0, 0.0, 1.0);

    float scale = 0.0;
    float bias = 0.0;

    for (int i = 0; i < FLUXION_DFG_SAMPLE_COUNT; i = i + 1)
    {
        Vector2 samplePoint = Fluxion_Sampling_Hammersley(i, FLUXION_DFG_SAMPLE_COUNT);
        Vector3 H = Fluxion_Sampling_GGXHalfVector(samplePoint, alphaRoughness, N);
        Vector3 L = H * (2.0 * dot(V, H)) - V;

        float NoL = Saturate(L.z);
        float NoH = Saturate(H.z);
        float VoH = Saturate(dot(V, H));

        if (NoL > 0.0)
        {
            float G = Fluxion_Dfg_GeometrySchlickGGX(NoL, k) * Fluxion_Dfg_GeometrySchlickGGX(NoV, k);

            // The distribution itself cancelled against the sampling
            // odds, which is the point of drawing samples from it; what
            // is left is the geometry term over the probability's own
            // cosines.
            float visibleG = G * VoH / max(NoH * NoV, FLUXION_EPSILON);

            // The Fresnel curve split into what every surface shares
            // (the fifth power) and what depends on f0 -- pulling f0 out
            // of the integral is what makes two numbers enough for every
            // material at once.
            float fresnelTail = Pow5(1.0 - VoH);

            scale = scale + (1.0 - fresnelTail) * visibleG;
            bias = bias + fresnelTail * visibleG;
        }
    }

    float perSample = 1.0 / float(FLUXION_DFG_SAMPLE_COUNT);
    return Vector2(scale * perSample, bias * perSample);
}

void main()
{
    int id = int(ThreadID);

    int size = int(dfgParams.x);

    if (id < size * size)
    {
        int y = id / size;
        int x = id - y * size;

        // Half a texel in, so the table's edges are the averages a
        // sampler will actually return there rather than the integrand's
        // degenerate corners.
        float NoV = (float(x) + 0.5) / float(size);
        float perceptualRoughness = (float(y) + 0.5) / float(size);

        Vector2 integrated = Fluxion_Dfg_Integrate(NoV, perceptualRoughness);

        int rowStride = int(dfgParams.y);
        dfgOut[y * rowStride + x] = Vector4(integrated.x, integrated.y, 0.0, 0.0);
    }
}

#endif
