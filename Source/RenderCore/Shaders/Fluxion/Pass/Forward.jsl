#ifndef FLUXION_PASS_FORWARD_INCLUDED
#define FLUXION_PASS_FORWARD_INCLUDED

#include "Fluxion/Lighting.jsl"
#include "Fluxion/Surface.jsl"
#include "Fluxion/Tonemap.jsl"
#include "Fluxion/Varyings.jsl"

// One of the ends a material can come to: lit here and now, into a single
// colour.
//
// The entry point lives here rather than in the material, which is the
// whole arrangement: a material declares `EvaluateSurface()` and stops, and the
// pass decides what becomes of what it returned. That is why the same
// material text can also be read by the pass next door without changing
// a character of it.
//
// This file is appended to a material's own source, so `EvaluateSurface()` is
// already declared by the time anything below calls it.

[Target(0)] Vector4 fragColor;

void main() {
  SurfaceData surface = EvaluateSurface();

  // Before anything is worked out about the pixel, because a pixel that
  // is not there is not worth lighting.
  if (SurfaceFailsAlphaTest(surface))
  {
    discard;
  }

  // Normalized here rather than trusted. What the vertex stage produced
  // was unit length at each corner, and what arrived is the average of
  // three of those -- which is shorter, by more the more curved the
  // surface is. A shorter normal makes every cosine in the lighting too
  // small, which reads as the object being darker in the middle of its
  // faces than at their edges.
  Vector3 N = normalize(surface.normal);

  Vector3 color = EvaluateLighting(surface, N, vWorldPosition);

  // The camera, after the lighting and not during it. Everything above
  // this line is an amount of light, in the same units for every surface
  // and every source; everything below is about turning that into a
  // number a screen can show.
  color = ApplyExposure(color, toneMapping.x);
  color = TonemapReinhard(color, toneMapping.y);

  // And the display's transfer function, if this target has none of its
  // own. A target whose format carries the sRGB curve has the hardware do
  // this, which is free and blends correctly; an ordinary eight-bit one
  // stores whatever bits it is given, and linear light written straight
  // into it comes out far too dark.
  //
  // Asked of the frame rather than assumed either way. Assuming it is
  // needed washes out every target that already does it; assuming it is
  // not leaves every target that does not.
  if (toneMapping.z > 0.5)
  {
    color = LinearToSRGB(color);
  }

  return Vector4(color, surface.opacity);
}

#endif
