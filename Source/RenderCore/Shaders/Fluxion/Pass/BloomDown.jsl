#ifndef FLUXION_PASS_BLOOM_DOWN_INCLUDED
#define FLUXION_PASS_BLOOM_DOWN_INCLUDED

#include "Fluxion/Math.jsl"

// ONE STEP DOWN THE BLOOM CHAIN: the level above, halved.
//
// What bloom is: light bright enough to scatter in a lens spreads into
// what is beside it. The spread is wide -- far wider than any filter one
// pass can afford -- so it is built the cheap way, by halving the picture
// again and again and blurring a little at each size. A small blur on a
// picture sixteen times smaller is a wide blur on the original, and the
// sum of all of them is the smooth falloff a real lens has.
//
// THE FIRST STEP IS DIFFERENT: it also decides what glows at all. Every
// step after it just carries what that one selected.

// x, y: how far one texel of the source is, as a coordinate.
// z: one on the first step, when what glows is still to be chosen.
// w: one when this backend's first texture row is the last screen row.
//
//    EVERY FULL-SCREEN PASS TURNS THE PICTURE OVER on that backend --
//    clip space counts up and the framebuffer's rows count down, so a
//    fragment at the top reads the bottom of what it samples. Two such
//    passes cancel and nobody notices; a CHAIN of them does not, because
//    the way back up adds each level onto one that was turned over an
//    odd number of times relative to it. Measured, without this: the
//    floor's glow appeared in the sky, mirrored, only on OpenGL.
[Uniform(Global)] Vector4 bloomStep;

// x: the brightness a pixel must reach before any of it glows.
// y: the knee -- how far below that the glow fades in rather than
//    switching on. Zero is a hard edge, which shows up as a rim that
//    crawls along a surface as the camera moves.
// zw: unused here.
[Uniform(Global)] Vector4 bloomCurve;

[Texture(Global)] Texture2D bloomSource;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragColor;

// How much of this colour glows: none below the threshold, all of it well
// above, and a smooth ramp across the knee.
//
// Measured on the BRIGHTEST CHANNEL rather than on luminance: a saturated
// red light at the same luminance as a grey surface is the one that
// glows, and luminance cannot tell them apart.
Vector3 BloomSelect(Vector3 color, float threshold, float knee)
{
  float brightest = max(color.x, max(color.y, color.z));

  float soft = brightest - threshold + knee;
  soft = clamp(soft, 0.0, 2.0 * knee);
  soft = soft * soft / (4.0 * knee + 0.00001);

  float glowing = max(soft, brightest - threshold) / max(brightest, 0.00001);
  return color * glowing;
}

void main() {
  // Read from where this fragment IS, whichever way this backend counts
  // its rows -- see bloomStep.w.
  Vector2 uv = Vector2(vUV.x, bloomStep.w > 0.5 ? 1.0 - vUV.y : vUV.y);

  // The four the halving covers: half a source texel either way. Each is
  // a bilinear read, so each already averages the four texels around it
  // -- sixteen texels for four reads.
  Vector2 offset = Vector2(0.5 * bloomStep.x, 0.5 * bloomStep.y);

  Vector3 sum = textureLod(bloomSource, uv + Vector2(-offset.x, -offset.y), 0.0).xyz;
  sum = sum + textureLod(bloomSource, uv + Vector2(offset.x, -offset.y), 0.0).xyz;
  sum = sum + textureLod(bloomSource, uv + Vector2(-offset.x, offset.y), 0.0).xyz;
  sum = sum + textureLod(bloomSource, uv + Vector2(offset.x, offset.y), 0.0).xyz;

  Vector3 color = sum * 0.25;

  if (bloomStep.z > 0.5)
  {
    color = BloomSelect(color, bloomCurve.x, bloomCurve.y);
  }

  return Vector4(color.x, color.y, color.z, 1.0);
}

#endif
