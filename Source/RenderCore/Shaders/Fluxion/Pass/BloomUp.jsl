#ifndef FLUXION_PASS_BLOOM_UP_INCLUDED
#define FLUXION_PASS_BLOOM_UP_INCLUDED

// ONE STEP BACK UP THE BLOOM CHAIN: a smaller level, spread and ADDED to
// the larger one it came from.
//
// Added, not written: the level being drawn into still holds what the way
// down put there, and the sum of the two is what makes the falloff smooth
// instead of stepped. That is what FLUXION_RHI_BLEND_MODE_ADD is for --
// no amount of alpha expresses "both".
//
// A TENT rather than a box: the nine taps are weighted 1-2-1 across and
// down, which is a triangle, and a triangle joined to the next triangle
// leaves no seam. A box leaves one at every level boundary, and they are
// visible as square edges in the glow.

// x, y: how far one texel of the source is, as a coordinate.
// z: unused here.
// w: one when this backend's first texture row is the last screen row.
//
//    EVERY FULL-SCREEN PASS TURNS THE PICTURE OVER on that backend --
//    clip space counts up and the framebuffer's rows count down, so a
//    fragment at the top reads the bottom of what it samples. Two such
//    passes cancel and nobody notices; a CHAIN of them does not, because
//    the way back up adds each level onto one that was turned over an
//    odd number of times relative to it. Measured, without this: the
//    floor's glow appeared in the sky, mirrored, only on OpenGL.
[Uniform(Global)] Vector4 bloomStep;
[Uniform(Global)] Vector4 bloomCurve;

[Texture(Global)] Texture2D bloomSource;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragColor;

void main() {
  Vector2 uv = Vector2(vUV.x, bloomStep.w > 0.5 ? 1.0 - vUV.y : vUV.y);

  float dx = bloomStep.x;
  float dy = bloomStep.y;

  Vector3 sum = textureLod(bloomSource, uv + Vector2(-dx, -dy), 0.0).xyz;
  sum = sum + textureLod(bloomSource, uv + Vector2(0.0, -dy), 0.0).xyz * 2.0;
  sum = sum + textureLod(bloomSource, uv + Vector2(dx, -dy), 0.0).xyz;

  sum = sum + textureLod(bloomSource, uv + Vector2(-dx, 0.0), 0.0).xyz * 2.0;
  sum = sum + textureLod(bloomSource, uv, 0.0).xyz * 4.0;
  sum = sum + textureLod(bloomSource, uv + Vector2(dx, 0.0), 0.0).xyz * 2.0;

  sum = sum + textureLod(bloomSource, uv + Vector2(-dx, dy), 0.0).xyz;
  sum = sum + textureLod(bloomSource, uv + Vector2(0.0, dy), 0.0).xyz * 2.0;
  sum = sum + textureLod(bloomSource, uv + Vector2(dx, dy), 0.0).xyz;

  // Sixteen, which is what the weights add up to.
  Vector3 color = sum / 16.0;

  return Vector4(color.x, color.y, color.z, 1.0);
}

#endif
