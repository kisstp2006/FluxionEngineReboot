#ifndef FLUXION_PASS_DEPTH_PYRAMID_INCLUDED
#define FLUXION_PASS_DEPTH_PYRAMID_INCLUDED

// ONE LEVEL OF THE DEPTH PYRAMID: the level above it, halved.
//
// Each texel here holds the FARTHEST depth of the area it covers.
//
// FARTHEST, NOT NEAREST, and the difference is the whole test. What a
// reader asks is "is this object behind everything that was drawn here",
// and that has to be true at EVERY pixel of the area -- so what it must be
// compared against is the furthest thing drawn in it. A pyramid of nearest
// depths answers a different question, and answering it instead culls
// objects that are plainly visible: measured, in a scene of 784 cubes on a
// floor, it left five of them.
//
// An average would be worse than either: it belongs to no surface, so the
// comparison would be against a depth nothing in the scene has.
//
// EVERYTHING HERE IS DONE IN COORDINATES, NOT IN TEXEL INDICES, and that
// is not a style choice. Which row of a render target the top of the
// screen lands in differs between backends; a shader that works out
// "which texel am I" from its own coordinate is right on one of them and
// vertically mirrored on the others -- and a mirrored pyramid culls by
// what is on the opposite side of the picture, which measured out as
// seven objects surviving from seven hundred. Sampling the source AT THE
// SAME COORDINATE has no such assumption in it: whatever orientation this
// pass rasterises in, the source was written in it too.
//
// Drawn rather than dispatched. A compute shader writing a texture needs a
// storage-image binding, and this contract has none -- what it has is
// render targets and a way to sample one mip level, which is enough: one
// small full-screen draw per level.

// x, y: how many texels the level being READ has.
// z, w: how many this one has.
[Uniform(Global)] Vector4 pyramidSizes;

[Texture(Global)] Texture2D pyramidSource;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragDepth;

void main() {
  Vector2 sourceSize = Vector2(pyramidSizes.x, pyramidSizes.y);
  Vector2 destSize = Vector2(pyramidSizes.z, pyramidSizes.w);

  // How far one texel of the level being read is, as a coordinate.
  Vector2 texel = Vector2(1.0 / sourceSize.x, 1.0 / sourceSize.y);

  // The four the halving covers: half a source texel either way from
  // where this one sits.
  float furthest = textureLod(pyramidSource, vUV + Vector2(-0.5 * texel.x, -0.5 * texel.y), 0.0).x;
  furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(0.5 * texel.x, -0.5 * texel.y), 0.0).x);
  furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(-0.5 * texel.x, 0.5 * texel.y), 0.0).x);
  furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(0.5 * texel.x, 0.5 * texel.y), 0.0).x);

  // AND THE ROW AN ODD SIZE LEAVES OVER. Halving 5 gives 2, and the fifth
  // row of the source belongs to no pair of texels -- left out, it is a
  // row of the picture no level above ever hears about, and something
  // hiding exactly there is culled while it is on screen.
  //
  // Taken from BOTH sides rather than from the end the arithmetic says,
  // because which end that is depends on the orientation this pass
  // rasterises in -- and reaching one texel too far can only make this
  // value larger, which culls LESS. Wrong in the direction that costs
  // time rather than in the direction that loses geometry.
  if (sourceSize.x > destSize.x * 2.0)
  {
    furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(-1.5 * texel.x, 0.0), 0.0).x);
    furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(1.5 * texel.x, 0.0), 0.0).x);
  }

  if (sourceSize.y > destSize.y * 2.0)
  {
    furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(0.0, -1.5 * texel.y), 0.0).x);
    furthest = max(furthest, textureLod(pyramidSource, vUV + Vector2(0.0, 1.5 * texel.y), 0.0).x);
  }

  return Vector4(furthest, furthest, furthest, furthest);
}

#endif
