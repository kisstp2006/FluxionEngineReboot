#ifndef FLUXION_PASS_OCCLUSION_DENOISE_INCLUDED
#define FLUXION_PASS_OCCLUSION_DENOISE_INCLUDED

// TAKING THE NOISE OUT WITHOUT TAKING THE EDGES WITH IT.
//
// The pass before this one samples a handful of directions per pixel and
// turns each pixel's slices by a different amount, so that too few
// samples come out as noise rather than as bands. Noise is the right
// trade -- it is the artefact an average removes -- but something has to
// do the averaging.
//
// A PLAIN BLUR WOULD NOT DO. The whole value of this effect is the dark
// line where two surfaces meet, and a blur wide enough to quiet the noise
// is wide enough to smear that line into a grey band several pixels
// across. So each neighbour is weighted by how much it agrees about how
// far away it is: across a crease the distances disagree, the weight
// collapses, and the edge survives.

// x, y: one texel of the picture.
// z:    how much of a difference in distance, in metres, halves a
//       neighbour's weight.
// w:    one when this backend's rows run the other way -- the same flag
//       every fullscreen pass in this engine carries.
[Uniform(Global)] Vector4 denoiseParams;

[Texture(Global)] Texture2D denoiseOcclusion;
[Texture(Global)] Texture2D denoiseDepth;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragOcclusion;

void main() {
  Vector2 readUV = Vector2(vUV.x, denoiseParams.w > 0.5 ? 1.0 - vUV.y : vUV.y);

  float centreDistance = textureLod(denoiseDepth, readUV, 0.0).x;

  float total = 0.0;
  float weightSum = 0.0;

  // A FIVE BY FIVE NEIGHBOURHOOD, and no wider. What has to be averaged
  // away is one sample's worth of variation, not a gradient -- and every
  // texel added is one more chance to reach across an edge that the
  // weight below then has to reject.
  for (int y = -2; y <= 2; y = y + 1)
  {
    for (int x = -2; x <= 2; x = x + 1)
    {
      Vector2 offset = Vector2(float(x) * denoiseParams.x, float(y) * denoiseParams.y);
      Vector2 uv = readUV + offset;

      float distance = textureLod(denoiseDepth, uv, 0.0).x;
      float occlusion = textureLod(denoiseOcclusion, uv, 0.0).x;

      // HOW MUCH THIS NEIGHBOUR IS THE SAME SURFACE. Far apart in depth
      // means a different surface, and a different surface has its own
      // answer that has no business here.
      float difference = abs(distance - centreDistance);
      float weight = 1.0 / (1.0 + difference / max(denoiseParams.z, 0.0001));

      total = total + occlusion * weight;
      weightSum = weightSum + weight;
    }
  }

  float result = weightSum > 0.0001 ? total / weightSum : 1.0;
  return Vector4(result, result, result, 1.0);
}

#endif
