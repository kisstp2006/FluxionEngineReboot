#ifndef FLUXION_PASS_LUMINANCE_DOWN_INCLUDED
#define FLUXION_PASS_LUMINANCE_DOWN_INCLUDED

#include "Fluxion/Grading.jsl"

// ONE NUMBER FOR THE WHOLE FRAME, WORKED OUT BY HALVING.
//
// The frame's brightness is an average, and an average of two million
// pixels is not something a fragment can take. So it is taken the way
// every reduction on this hardware is taken: each step reads four texels
// and writes their average into one, and after nine of them what is left
// is a single texel holding the average of everything.
//
// WHAT IS AVERAGED IS THE LOGARITHM, and that is the decision in here.
// Averaging brightness itself lets one small very bright thing -- a lamp,
// the sun in a window -- outweigh the entire rest of the picture, and the
// camera then stops down until the room goes black. Averaging the
// logarithm is averaging in stops, where a lamp four stops above the room
// counts as four rather than as sixteen.
//
// NOTHING HERE FLIPS ANYTHING, unlike the glow's chain. An average does
// not have a top or a bottom, so which end of the texture the first row
// is at cannot change the answer -- and the one texel this ends at has
// neither.

// x, y: one texel of what is being READ, so the four taps land in the
//       middle of the four texels being merged.
// z:    one when what is being read is the scene rather than a level of
//       this chain -- the step that turns light into stops. Every step
//       after it is averaging numbers that are already stops.
// w:    unused.
[Uniform(Global)] Vector4 lumStep;

[Texture(Global)] Texture2D lumSource;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragColor;

void main() {
  Vector2 offset = Vector2(lumStep.x * 0.5, lumStep.y * 0.5);

  Vector4 a = textureLod(lumSource, vUV + Vector2(-offset.x, -offset.y), 0.0);
  Vector4 b = textureLod(lumSource, vUV + Vector2(offset.x, -offset.y), 0.0);
  Vector4 c = textureLod(lumSource, vUV + Vector2(-offset.x, offset.y), 0.0);
  Vector4 d = textureLod(lumSource, vUV + Vector2(offset.x, offset.y), 0.0);

  float value = 0.0;
  if (lumStep.z > 0.5)
  {
    // A FLOOR UNDER THE DARK, because the logarithm of nothing is not a
    // number. A pixel this dark is far below anything a screen can show,
    // so clamping it changes no picture -- and not clamping it makes the
    // average of every picture with a black pixel in it undefined.
    float floorLight = 0.0001;

    float la = log2(max(GradingLuminance(a.xyz), floorLight));
    float lb = log2(max(GradingLuminance(b.xyz), floorLight));
    float lc = log2(max(GradingLuminance(c.xyz), floorLight));
    float ld = log2(max(GradingLuminance(d.xyz), floorLight));
    value = (la + lb + lc + ld) * 0.25;
  }
  else
  {
    value = (a.x + b.x + c.x + d.x) * 0.25;
  }

  return Vector4(value, value, value, 1.0);
}

#endif
