#ifndef FLUXION_PASS_SHADOW_DEPTH_INCLUDED
#define FLUXION_PASS_SHADOW_DEPTH_INCLUDED

#include "Fluxion/Object.jsl"

// The world as one light sees it, so a surface can later ask whether
// anything stood between it and that light.
//
// Its own vertex stage rather than the shared one, and for a reason
// worth stating: every other pass is drawn from the CAMERA and reads the
// frame's view-projection. This one is drawn from a LIGHT, and there is
// one of these per light per frame -- so the matrix arrives on its own,
// in the Global group, rather than through a frame the whole frame
// shares.
//
// The position is all it reads. A depth map holds where surfaces are and
// nothing about what they look like, so the normal, tangent and texture
// coordinates the mesh also carries are left where they are.
[Uniform(Global)] Matrix4x4 lightViewProjection;

[Input] Vector3 position;
[Output] Vector4 Position;

void main() {
  // Through the object's own placement first, then into the light's
  // clip space -- the same two steps the camera's vertex stage takes,
  // with the light's matrix in the camera's place.
  Position = lightViewProjection * (FluxionObjectModel() * Vector4(position, 1.0));
}

#endif
