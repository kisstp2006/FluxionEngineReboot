#ifndef FLUXION_PASS_IRRADIANCE_PROJECT_INCLUDED
#define FLUXION_PASS_IRRADIANCE_PROJECT_INCLUDED

#include "Fluxion/Math.jsl"

// Turning a sky into nine numbers per channel, once.
//
// Runs when an environment is loaded and never again while it is
// unchanged, which is what lets it be this direct: every thread walks the
// whole sky, and there is no reduction between threads, no shared memory
// and no atomics. Nine threads, one per coefficient. Everything a thread
// needs is its own.
//
// The alternative -- splitting the sky between threads and combining
// afterwards -- is faster and is a different program, with a second pass
// and a barrier in it. It is worth writing when this shows up in a
// measurement, and not before.
//
// The maths is from the published description of the method; see
// SHADER_SOURCES.md.

// The Global group, and the choice is load-bearing: a group's name IS its
// descriptor set index, and this pipeline is built with exactly one bind
// group layout, at index zero. Global is the group that maps to zero. A
// binding declared in any other group would land in a set the pipeline
// never declared, and the backend would refuse the whole pipeline.
[Texture(Global)] TextureCube environmentSource;
[Buffer(Global)] Vector4 irradianceOut;

// How finely the sky is walked, per face, regardless of how large it
// actually is.
//
// A fixed grid rather than one texel per step, and that is deliberate:
// what is being fitted has three bands in it, so nothing beyond a coarse
// sampling of the sky can survive into the result. Tying the work to the
// texture's size instead would make a large environment cost hundreds of
// times more for an answer that is the same to several decimals.
//
// Sampled with filtering, so a grid finer than the texture costs nothing
// wrong -- it reads the same texels more than once -- and a grid coarser
// than the texture still sees an average rather than a scattering of
// single texels.
#define FLUXION_IRRADIANCE_GRID 64

// Which way the middle of a cell on this face looks.
//
// The same six-face convention as everything else that builds or reads a
// cube map here: +X, -X, +Y, -Y, +Z, -Z, with +Y straight up.
Vector3 Fluxion_Irradiance_FaceDirection(int face, float u, float v)
{
    if (face < 1) { return Vector3(1.0, -v, -u); }
    if (face < 2) { return Vector3(-1.0, -v, u); }
    if (face < 3) { return Vector3(u, 1.0, v); }
    if (face < 4) { return Vector3(u, -1.0, -v); }
    if (face < 5) { return Vector3(u, -v, 1.0); }
    return Vector3(-u, -v, -1.0);
}

// The corner term of the solid angle a cube-map cell covers -- a middle
// cell covers more of the sphere than a corner one, and weighting them
// equally biases the whole fit the same way on every face. Closed form
// from integrating the differential solid angle; the four corners
// combine below as any double integral does at its bounds. The
// one-argument arctangent is exact here: the denominator is always
// positive, which is all the two-argument form exists to resolve.
float Fluxion_Irradiance_AreaElement(float x, float y)
{
    return atan(x * y / sqrt(x * x + y * y + 1.0));
}

// One of the nine basis functions, chosen by index.
//
// Each thread evaluates only its own, so this is a choice made once per
// sample rather than nine values computed and eight thrown away.
float Fluxion_Irradiance_BasisAt(int index, Vector3 d)
{
    if (index < 1) { return 0.282095; }
    if (index < 2) { return 0.488603 * d.y; }
    if (index < 3) { return 0.488603 * d.z; }
    if (index < 4) { return 0.488603 * d.x; }
    if (index < 5) { return 1.092548 * d.x * d.y; }
    if (index < 6) { return 1.092548 * d.y * d.z; }
    if (index < 7) { return 0.315392 * (3.0 * d.z * d.z - 1.0); }
    if (index < 8) { return 1.092548 * d.x * d.z; }
    return 0.546274 * (d.x * d.x - d.y * d.y);
}

// How much of each band survives the cosine lobe -- what turns light
// ARRIVING from every direction into light FALLING ON a surface. In this
// basis the whole convolution is one number per band, which is the
// reason the representation is worth having. Folded in here, once,
// because the surfaces reading it are many; past the third band the
// numbers are small enough to drop the bands, which is why nine.
float Fluxion_Irradiance_CosineConvolution(int index)
{
    if (index < 1) { return FLUXION_PI; }
    if (index < 4) { return 2.0 * FLUXION_PI / 3.0; }
    return FLUXION_PI / 4.0;
}

void main()
{
    int index = int(ThreadID);

    // The dispatch is one group and a group is wider than nine. The
    // threads past the end have no coefficient to write and must not
    // write one: the buffer is exactly nine long, and past it is whatever
    // the allocator handed out next.
    if (index < 9)
    {
        float convolution = Fluxion_Irradiance_CosineConvolution(index);
        float cell = 1.0 / float(FLUXION_IRRADIANCE_GRID);

        Vector3 total = Vector3(0.0, 0.0, 0.0);

        for (int face = 0; face < 6; face = face + 1)
        {
            for (int j = 0; j < FLUXION_IRRADIANCE_GRID; j = j + 1)
            {
                float v = (float(j) + 0.5) * 2.0 * cell - 1.0;

                for (int i = 0; i < FLUXION_IRRADIANCE_GRID; i = i + 1)
                {
                    float u = (float(i) + 0.5) * 2.0 * cell - 1.0;

                    // The four corners of this cell, in the flat
                    // coordinates of the face it sits on.
                    float x0 = u - cell;
                    float x1 = u + cell;
                    float y0 = v - cell;
                    float y1 = v + cell;

                    float solidAngle = Fluxion_Irradiance_AreaElement(x1, y1)
                                     - Fluxion_Irradiance_AreaElement(x0, y1)
                                     - Fluxion_Irradiance_AreaElement(x1, y0)
                                     + Fluxion_Irradiance_AreaElement(x0, y0);

                    Vector3 direction = normalize(Fluxion_Irradiance_FaceDirection(face, u, v));

                    // An explicit level, because there is no other kind
                    // available here. A dispatch has no neighbouring
                    // pixels to compare a coordinate against, so there is
                    // nothing for an ordinary sample to work a level out
                    // from.
                    Vector3 radiance = textureLod(environmentSource, direction, 0.0).xyz;

                    total = total + radiance * (Fluxion_Irradiance_BasisAt(index, direction) * solidAngle);
                }
            }
        }

        irradianceOut[index] = Vector4(total * convolution, 0.0);
    }
}

#endif
