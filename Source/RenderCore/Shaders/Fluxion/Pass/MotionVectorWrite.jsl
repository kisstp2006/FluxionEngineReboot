#ifndef FLUXION_PASS_MOTION_VECTOR_WRITE_INCLUDED
#define FLUXION_PASS_MOTION_VECTOR_WRITE_INCLUDED

// The fragment half: the pair of clip positions, turned into one
// direction on the screen.
//
// WHAT COMES OUT is where this pixel was LAST frame minus where it is
// NOW, in the same coordinates a texture is sampled by -- so a later
// pass reads this, adds it to its own coordinate, and lands on the pixel
// that showed this surface a frame ago. That direction, and not the
// other way round, because reprojection is the thing every consumer of
// this does.
//
// The divide happens here rather than in the vertex stage: a perspective
// divide interpolated across a triangle is not the divide of the
// interpolated value, and the difference shows up exactly where a
// surface is steep -- which is where motion is most visible.

[Input] Vector4 vCurrentClip;
[Input] Vector4 vPreviousClip;

[Target(0)] Vector4 fragMotion;

void main() {
  // Behind the eye, or exactly on it: there is no screen position to
  // speak of, and dividing anyway produces a number that is worse than
  // no answer. Zero is "it did not move", which is what a consumer does
  // least harm with.
  if (vCurrentClip.w <= 0.0 || vPreviousClip.w <= 0.0)
  {
    return Vector4(0.0, 0.0, 0.0, 0.0);
  }

  Vector2 current = vCurrentClip.xy / vCurrentClip.w;
  Vector2 previous = vPreviousClip.xy / vPreviousClip.w;

  // Clip coordinates run from -1 to 1 across the screen and texture
  // coordinates from 0 to 1, so a difference between two of them is half
  // as large in the coordinates this is read in. The vertical axis is
  // NOT flipped here: what is written is a difference, and both ends of
  // it are in the same space whichever way that space's rows run.
  Vector2 motion = (previous - current) * 0.5;

  return Vector4(motion.x, motion.y, 0.0, 0.0);
}

#endif
