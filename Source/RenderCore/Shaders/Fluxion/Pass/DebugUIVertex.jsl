#ifndef FLUXION_PASS_DEBUG_UI_VERTEX_INCLUDED
#define FLUXION_PASS_DEBUG_UI_VERTEX_INCLUDED

// FLAT GEOMETRY IN PIXELS, put on the screen.
//
// The panels arrive as triangles already laid out in pixel coordinates --
// the toolkit underneath decided where every rectangle and glyph goes, and
// this stage only says what "in pixels" means for the screen it is being
// drawn on. The one matrix it needs is the size of that screen, which is
// why it is a pair of numbers rather than a matrix.

// x, y: how many pixels the screen is, so a position can be turned into
//       clip space. zw unused.
[Uniform(Global)] Vector4 uiScreen;

[Input] Vector2 position;
[Input] Vector2 uv;
[Input] Vector4 color;

[Output] Vector2 vUV;
[Output] Vector4 vColor;
[Output] Vector4 Position;

void main() {
  vUV = uv;
  vColor = color;

  // Pixels to clip space: across is 0..width, and DOWN is 0..height --
  // which is why the second one is negated. A user interface counts from
  // the top left corner, and clip space counts up from the middle.
  float x = position.x / uiScreen.x * 2.0 - 1.0;
  float y = 1.0 - position.y / uiScreen.y * 2.0;

  Position = Vector4(x, y, 0.0, 1.0);
}

#endif
