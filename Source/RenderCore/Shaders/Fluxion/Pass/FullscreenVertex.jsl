#ifndef FLUXION_PASS_FULLSCREEN_VERTEX_INCLUDED
#define FLUXION_PASS_FULLSCREEN_VERTEX_INCLUDED

// THREE VERTICES THAT COVER THE SCREEN, and nothing else.
//
// The positions arrive in clip space already, from a three-vertex buffer
// the pass owns -- this stage transforms nothing, because a pass that
// works on the picture rather than on the world has no geometry to place.
//
// A triangle rather than two triangles of a quad: one triangle large
// enough to cover the screen has no seam down the middle, and the corners
// that fall outside are clipped for free.
//
// The texture coordinate is the clip position turned the right way up for
// reading a texture: clip counts from -1 at the bottom to 1 at the top,
// and a texture's second coordinate counts from 0 at its FIRST row. Which
// row that is on the screen differs between backends, and the engine's
// answer is written down once, here, rather than at every pass that reads
// its own output.

[Input] Vector2 position;

[Output] Vector2 vUV;
[Output] Vector4 Position;

void main() {
  vUV = Vector2(position.x * 0.5 + 0.5, 0.5 - position.y * 0.5);
  Position = Vector4(position, 0.0, 1.0);
}

#endif
