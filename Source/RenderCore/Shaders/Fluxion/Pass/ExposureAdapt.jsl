#ifndef FLUXION_PASS_EXPOSURE_ADAPT_INCLUDED
#define FLUXION_PASS_EXPOSURE_ADAPT_INCLUDED

// THE ONE TEXEL THE CAMERA IS SET FROM.
//
// What arrives is the frame's average brightness in stops and what the
// camera was set to last frame. What leaves is what it is set to now --
// which is not the same thing, and that is the entire pass.
//
// A CAMERA THAT ARRIVED INSTANTLY WOULD BE WRONG, not merely unpleasant.
// Walking past a window would make the whole room go dark for one frame
// and back for the next; a cloud crossing the sun would strobe. What an
// eye does, and what a camera with automatic exposure does, is take a
// moment -- so this covers a fraction of the remaining distance and
// leaves the rest for the frames after it.

// x: where middle grey should land.
// y: how much of the remaining distance is covered THIS FRAME. Worked
//    out from the speed and the length of the frame before this one, so
//    that the same look comes out at any frame rate -- see the pass.
// z, w: the lowest and highest the camera may be set to.
[Uniform(Global)] Vector4 adaptParams;

// The end of the chain: one texel, holding the average of the logarithm
// of the frame's brightness.
[Texture(Global)] Texture2D adaptMeasured;

// What the camera was set to last frame. On the first frame there is no
// last frame, and the fraction above is then one -- which reads this and
// throws it away rather than trusting whatever is in the texture.
[Texture(Global)] Texture2D adaptPrevious;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragColor;

void main() {
  Vector2 middle = Vector2(0.5, 0.5);

  float averageStops = textureLod(adaptMeasured, middle, 0.0).x;
  float averageLight = exp2(averageStops);

  // A FLOOR UNDER THE DIVISION, and it is not the same floor as the
  // chain's. That one keeps a logarithm defined; this one keeps a
  // division finite -- a frame with nothing in it would otherwise ask for
  // an infinite exposure, and the range below cannot clamp an infinity
  // that has already become a not-a-number.
  float wanted = adaptParams.x / max(averageLight, 0.0001);
  wanted = clamp(wanted, adaptParams.z, adaptParams.w);

  float previous = textureLod(adaptPrevious, middle, 0.0).x;

  // AND THE PREVIOUS ONE IS CLAMPED TOO. It came out of this same pass
  // and so is already in range -- except on the first frame, where it is
  // whatever the allocator left in the texture, and a single not-a-number
  // there would poison every frame after it through this very line.
  previous = clamp(previous, adaptParams.z, adaptParams.w);

  float exposure = previous + (wanted - previous) * adaptParams.y;

  return Vector4(exposure, exposure, exposure, 1.0);
}

#endif
