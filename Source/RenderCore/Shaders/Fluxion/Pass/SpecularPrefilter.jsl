#ifndef FLUXION_PASS_SPECULAR_PREFILTER_INCLUDED
#define FLUXION_PASS_SPECULAR_PREFILTER_INCLUDED

#include "Fluxion/CubeMapping.jsl"
#include "Fluxion/ImportanceSampling.jsl"

// Blurring the sky the way a rough mirror would, one roughness per run.
//
// A rough surface reflects a cone of directions, not one; what this pass
// writes for a texel is the sky averaged over that cone, so that at draw
// time reading one texel answers what an integral would have. Runs once
// per environment per mip, never per frame. Maths from the published
// description; see SHADER_SOURCES.md.
//
// Global group, one bind group at index zero, same as every pass that
// runs alone -- see IrradianceProject.jsl for why the name is
// load-bearing.
[Uniform(Global)] Vector4 prefilterParams;
[Texture(Global)] TextureCube environmentSource;
[Buffer(Global)] Vector4 prefilterOut;

// prefilterParams:
//   x  the face width in texels of the mip being written
//   y  the perceptual roughness this mip stands for
//   z  texels from one output row to the next (copy alignment padding)
//   w  texels from one face to the next (copy alignment padding)

#define FLUXION_PREFILTER_SAMPLE_COUNT 1024

Vector3 Fluxion_Prefilter_Filter(Vector3 N, float perceptualRoughness)
{
    // The one approximation this technique is named for: the viewer is
    // taken to be looking straight along the normal. It costs the
    // stretched grazing-angle highlights, and it is what makes the
    // result a function of one direction -- storable in a cube map at
    // all.
    Vector3 V = N;

    float alphaRoughness = Square(perceptualRoughness);

    Vector3 total = Vector3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;

    for (int i = 0; i < FLUXION_PREFILTER_SAMPLE_COUNT; i = i + 1)
    {
        Vector2 samplePoint = Fluxion_Sampling_Hammersley(i, FLUXION_PREFILTER_SAMPLE_COUNT);
        Vector3 H = Fluxion_Sampling_GGXHalfVector(samplePoint, alphaRoughness, N);
        Vector3 L = H * (2.0 * dot(V, H)) - V;

        float NoL = dot(N, L);
        if (NoL > 0.0)
        {
            // Weighted by the cosine, which the published description
            // adopts for looking better rather than deriving -- the
            // approximation above already left exactness behind.
            total = total + textureLod(environmentSource, L, 0.0).xyz * NoL;
            totalWeight = totalWeight + NoL;
        }
    }

    return total / max(totalWeight, FLUXION_EPSILON);
}

void main()
{
    int id = int(ThreadID);

    int width = int(prefilterParams.x);
    int texelsPerFace = width * width;

    // The dispatch is rounded up to whole groups, so the tail threads
    // have no texel. The buffer holds only what the copies read.
    if (id < texelsPerFace * 6)
    {
        int face = id / texelsPerFace;
        int local = id - face * texelsPerFace;
        int y = local / width;
        int x = local - y * width;

        float cell = 1.0 / float(width);
        float u = (float(x) + 0.5) * 2.0 * cell - 1.0;
        float v = (float(y) + 0.5) * 2.0 * cell - 1.0;

        Vector3 N = normalize(Fluxion_CubeMap_FaceDirection(face, u, v));
        Vector3 filtered = Fluxion_Prefilter_Filter(N, prefilterParams.y);

        int rowStride = int(prefilterParams.z);
        int faceStride = int(prefilterParams.w);
        prefilterOut[face * faceStride + y * rowStride + x] = Vector4(filtered, 1.0);
    }
}

#endif
