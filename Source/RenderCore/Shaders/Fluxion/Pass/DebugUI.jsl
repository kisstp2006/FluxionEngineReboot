#ifndef FLUXION_PASS_DEBUG_UI_INCLUDED
#define FLUXION_PASS_DEBUG_UI_INCLUDED

// A PANEL'S PIXELS: a colour, times whatever the atlas holds there.
//
// Every rectangle the toolkit draws goes through this, glyphs included --
// a solid rectangle simply reads a part of the atlas that is white, so
// text and boxes are the same draw with the same shader. That is what
// makes a whole interface one or two draws instead of hundreds.

// DECLARED IN BOTH STAGES, like the frame constants are. What binding a
// name gets is decided per stage, so a uniform the vertex stage names and
// the fragment stage does not would leave the two disagreeing about which
// number the texture after it has -- and a texture read at the number of
// a uniform buffer is a validation error at best.
[Uniform(Global)] Vector4 uiScreen;

[Texture(Global)] Texture2D uiAtlas;

[Input] Vector2 vUV;
[Input] Vector4 vColor;

[Target(0)] Vector4 fragColor;

void main() {
  Vector4 sampled = textureLod(uiAtlas, vUV, 0.0);

  // NO TRANSFER FUNCTION HERE. These colours are already the numbers a
  // screen should show -- the panels are drawn on top of the finished
  // picture, after everything that turns light into colour has run.
  return vColor * sampled;
}

#endif
