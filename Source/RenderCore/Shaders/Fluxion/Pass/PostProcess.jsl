#ifndef FLUXION_PASS_POST_PROCESS_INCLUDED
#define FLUXION_PASS_POST_PROCESS_INCLUDED

#include "Fluxion/Tonemap.jsl"

// THE ONE PLACE THE PICTURE STOPS BEING AN AMOUNT OF LIGHT.
//
// Everything before this writes light: the forward pass, the sky, the
// debug lines. All of it lands in a target that can hold values far
// above one, and none of it decides what a screen should show. That
// decision is here, once, for the whole picture.
//
// It used to live in the material shaders, and that made two things
// impossible. Every material had to repeat it, so a new one that forgot
// was wrong in a way nothing could catch; and anything that reads the
// picture as light -- what glows, how bright the frame is on average --
// had nothing left to read, because the values were already squashed
// into the range a screen can show.

// x: the exposure multiplier, one number for the whole frame.
// y: the tone curve's white point; at or below zero means do not map.
// z: one when this target needs the display's transfer function applied
//    here, zero when its format carries it.
// w: one when this backend's first texture row is the last screen row.
//
//    THE ONE PLACE IT MATTERS. Every other pass in this engine reads a
//    texture it rendered and writes another one, so both ends count
//    their rows the same way and the question never arises. This pass
//    reads a rendered texture and writes THE SCREEN -- and on the
//    backend whose framebuffers start at the bottom, those two disagree.
//    Measured, without this: the sky at the bottom of the window and the
//    floor across the top.
[Uniform(Global)] Vector4 postParams;

// x: how much of the glow is added back; zero means none, and then what
//    is bound below is the scene itself rather than a glow.
// yzw: unused.
[Uniform(Global)] Vector4 postBloom;

[Texture(Global)] Texture2D sceneColor;

// WHAT GLOWS, ALREADY SPREAD -- see BloomDown.jsl and BloomUp.jsl. Half
// the size of the picture, which is why it is read with a filter that
// smooths rather than by texel.
[Texture(Global)] Texture2D bloomColor;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragColor;

void main() {
  Vector2 uv = Vector2(vUV.x, postParams.w > 0.5 ? 1.0 - vUV.y : vUV.y);

  Vector3 color = textureLod(sceneColor, uv, 0.0).xyz;

  // ADDED BEFORE THE CAMERA AND THE CURVE, not after: a glow is light,
  // and light is what the exposure decides the brightness of. Added
  // afterwards it would be a wash of colour laid over a finished picture,
  // and it would not brighten with the rest of the frame when the camera
  // opens up.
  color = color + textureLod(bloomColor, uv, 0.0).xyz * postBloom.x;

  // The camera first, then the curve: exposure decides how much light
  // makes middle grey, and the curve decides what happens to what is
  // still above one afterwards. Reversed, the curve would be applied to
  // an amount of light that no camera setting had been chosen for.
  color = ApplyExposure(color, postParams.x);
  color = TonemapReinhard(color, postParams.y);

  if (postParams.z > 0.5)
  {
    color = LinearToSRGB(color);
  }

  return Vector4(color.x, color.y, color.z, 1.0);
}

#endif
