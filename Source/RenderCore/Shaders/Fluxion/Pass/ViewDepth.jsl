#ifndef FLUXION_PASS_VIEW_DEPTH_INCLUDED
#define FLUXION_PASS_VIEW_DEPTH_INCLUDED

// HOW FAR AWAY EACH PIXEL IS, IN METRES, AND THEN THE SAME AT HALF SIZE.
//
// A depth buffer does not hold distance. It holds a number chosen so that
// the hardware can compare and interpolate it cheaply, and the relation
// between it and distance is a division -- most of its precision sits in
// the first few metres. Everything that measures the SHAPE of a surface
// wants the distance itself: two depths a hundredth apart are half a
// millimetre at arm's length and ten metres away across a field.
//
// So this converts once, and then halves. The levels exist so that a
// sample taken far from the pixel being shaded can be read from a level
// where far is only a few texels -- which is both cheaper and quieter
// than reading the full-size picture in a wide circle.
//
// AVERAGED ON THE WAY DOWN, unlike the depth pyramid next door, which
// keeps the farthest. That one answers "is all of this behind something",
// where only the extreme will do; this one answers "roughly how far away
// is this area", where the extreme is the worst answer available.

// x, y: how many texels the level being READ has.
// z, w: how many this one has.
[Uniform(Global)] Vector4 viewDepthSizes;

// x, y: the two numbers that turn a depth into a distance, taken from the
//       projection this frame was drawn with: distance = y / (depth + x).
//       Both come from the matrix rather than from a near and a far plane
//       -- a caller may hand over any projection it likes, and these two
//       are what it actually says.
//
// z:    one when what is being read is the depth buffer rather than a
//       level of this chain. Every level after the first is already in
//       metres and only needs averaging.
//
// w:    one when this backend's rows run the other way -- see the read
//       below. Every fullscreen pass in this engine carries one of these.
[Uniform(Global)] Vector4 viewDepthParams;

[Texture(Global)] Texture2D viewDepthSource;

[Input] Vector2 vUV;
[Target(0)] Vector4 fragViewDepth;

void main() {
  Vector2 sourceSize = Vector2(viewDepthSizes.x, viewDepthSizes.y);
  Vector2 texel = Vector2(1.0 / sourceSize.x, 1.0 / sourceSize.y);

  // WHERE TO READ, which is not always where this pass is writing. On the
  // backend whose framebuffer starts at the bottom, a fullscreen pass
  // lands in the row that counts from the other end -- so it reads from
  // the other end too, and what it writes stays lined up with what drew
  // the scene. The same flag every fullscreen pass in this engine carries.
  Vector2 uv = Vector2(vUV.x, viewDepthParams.w > 0.5 ? 1.0 - vUV.y : vUV.y);

  Vector4 gathered = Vector4(
    textureLod(viewDepthSource, uv + Vector2(-0.5 * texel.x, -0.5 * texel.y), 0.0).x,
    textureLod(viewDepthSource, uv + Vector2(0.5 * texel.x, -0.5 * texel.y), 0.0).x,
    textureLod(viewDepthSource, uv + Vector2(-0.5 * texel.x, 0.5 * texel.y), 0.0).x,
    textureLod(viewDepthSource, uv + Vector2(0.5 * texel.x, 0.5 * texel.y), 0.0).x);

  float result = 0.0;

  if (viewDepthParams.z > 0.5)
  {
    // FOUR DEPTHS TURNED INTO FOUR DISTANCES AND THEN AVERAGED -- in that
    // order, and it matters. The relation is a division, so the average
    // of four depths is not the depth of the average distance; averaging
    // first would put the first level's every texel somewhere no surface
    // is, and by more the steeper the surface.
    Vector4 distances = Vector4(
      viewDepthParams.y / (gathered.x + viewDepthParams.x),
      viewDepthParams.y / (gathered.y + viewDepthParams.x),
      viewDepthParams.y / (gathered.z + viewDepthParams.x),
      viewDepthParams.y / (gathered.w + viewDepthParams.x));

    result = (distances.x + distances.y + distances.z + distances.w) * 0.25;
  }
  else
  {
    result = (gathered.x + gathered.y + gathered.z + gathered.w) * 0.25;
  }

  return Vector4(result, result, result, 1.0);
}

#endif
