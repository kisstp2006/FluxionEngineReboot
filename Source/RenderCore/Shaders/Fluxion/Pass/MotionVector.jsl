#ifndef FLUXION_PASS_MOTION_VECTOR_INCLUDED
#define FLUXION_PASS_MOTION_VECTOR_INCLUDED

#include "Fluxion/Frame.jsl"
#include "Fluxion/Object.jsl"

// WHERE EACH PIXEL WAS A FRAME AGO.
//
// The vertex half. It puts the same vertex through two matrices -- this
// frame's placement and this frame's camera, then last frame's placement
// and last frame's camera -- and hands both answers to the fragment
// stage, which turns the pair into a direction on the screen.
//
// The two are carried as clip positions rather than as a finished vector
// because the divide by w has to happen PER PIXEL. Doing it here and
// interpolating the result would interpolate a division, which is not
// the same thing and is wrong exactly where the geometry is steep.
//
// Its own vertex stage rather than the shared one: no other pass needs
// last frame's placement, and every varying costs every pass that shares
// the file.

[Input] Vector3 position;

[Output] Vector4 vCurrentClip;
[Output] Vector4 vPreviousClip;
[Output] Vector4 Position;

void main() {
  Vector4 currentClip = viewProjection * (FluxionObjectModel() * Vector4(position, 1.0));
  Vector4 previousClip = previousViewProjection * (FluxionObjectPreviousModel() * Vector4(position, 1.0));

  vCurrentClip = currentClip;
  vPreviousClip = previousClip;

  // The geometry itself goes where it goes this frame -- the depth test
  // this pass shares with the frame's depth buffer only agrees if this
  // is the position the other passes produce.
  Position = currentClip;
}

#endif
