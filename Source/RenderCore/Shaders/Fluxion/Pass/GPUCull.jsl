#ifndef FLUXION_PASS_GPU_CULL_INCLUDED
#define FLUXION_PASS_GPU_CULL_INCLUDED

// DECIDING WHAT IS SEEN, ON THE DEVICE.
//
// One thread per object. It answers the same question the processor
// answers in GPUScene.c -- is this object in front of the eye, and near
// enough -- and writes its answer to the same two places: the list of
// what each batch draws, and that batch's instance count.
//
// The instance count IS the counter. A thread that finds its object
// visible adds one to it and is handed the slot it just claimed, which
// is what an atomic add is for: no thread has to know what the others
// found, and the answer is the same however they are scheduled.
//
// WHAT IS NOT DECIDED HERE: which layers an object belongs to. This
// language has no bitwise operators yet, so the mask test is answered on
// the processor and arrives as a yes or a no -- said here rather than
// left to be discovered from a layer that stops working.

// The Global group, and the choice is load-bearing for the same reason
// it is in Fluxion/Pass/IrradianceProject.jsl: a group's name IS its
// descriptor set index, and this pipeline is built with one bind group
// layout, at index zero.

// xyz: a plane's normal, w: its distance. Six of them, in the order
// Fluxion_Mat4_FrustumPlanes writes them.
[Uniform(Global)] Vector4 cullPlane0;
[Uniform(Global)] Vector4 cullPlane1;
[Uniform(Global)] Vector4 cullPlane2;
[Uniform(Global)] Vector4 cullPlane3;
[Uniform(Global)] Vector4 cullPlane4;
[Uniform(Global)] Vector4 cullPlane5;

// xyz: where the eye is. w: how far it sees, or zero for no limit.
[Uniform(Global)] Vector4 cullEye;

// x: how many objects there are. Checked by every thread, because a
// dispatch is rounded up to whole groups and the last group's spare
// threads have no object of their own.
[Uniform(Global)] Vector4 cullCounts;

// WHERE THE CAMERA WAS WHEN THE PYRAMID BELOW WAS DRAWN.
//
// The pyramid holds the frame BEFORE this one, so an object has to be
// put on the screen the way that frame saw it -- through this matrix and
// not through the current one. A test done with this frame's camera
// against last frame's depth is a test of two different pictures, and
// what it culls is whatever moved.
[Uniform(Global)] Matrix4x4 cullPreviousViewProjection;

// x, y: how many texels the pyramid's first level has.
// z: how many levels it has.
// w: one when it may be used at all -- zero on the first frame, after a
//    resize, and after the camera jumped, because there is no previous
//    frame to be hidden by then.
[Uniform(Global)] Vector4 cullPyramidParams;

// The frame before this one, as closest-depths -- see
// Fluxion/Pass/DepthPyramid.jsl.
[Texture(Global)] Texture2D cullPyramid;

// One indirect draw, as the RHI lays it out --
// FluxionRHIDrawIndexedIndirectCommand said in this language. The
// instance count is the field this pass writes.
struct FluxionCullCommand
{
    int indexCount;
    int instanceCount;
    int firstIndex;
    int vertexOffset;
    int firstInstance;
};

// xyz: the object's centre in world space, w: its radius.
[Buffer(Global)] Vector4 cullSpheres;

// Which batch each object belongs to, and whether its layers passed --
// two lists rather than fields in one struct, because a struct mixing
// integers and vectors is packed differently by the two shading
// languages and this way nothing has to be remembered about that.
[Buffer(Global)] int cullBatches;
[Buffer(Global)] int cullLayerPass;

// Where each batch's slice of the visible list begins.
[Buffer(Global)] int cullBatchFirst;

// What the frame draws, and what draws it.
[Buffer(Global)] int visibleObjects;
[Buffer(Global)] FluxionCullCommand cullCommands;

// WHETHER SOMETHING WAS ALREADY HIDDEN, one frame ago.
//
// The object's box is put on the screen as the previous frame saw it, and
// the nearest depth it reaches is compared against the FARTHEST depth the
// pyramid holds over that rectangle. If even the nearest part of the
// object is behind the furthest thing that was drawn there, then at every
// pixel of that rectangle something was in front of it -- and nothing of
// it could have been seen.
//
// ONE FRAME LATE, and that is the trade this makes: something that has
// just come out from behind a wall is culled for exactly one frame. What
// it buys is the test costing four texel reads instead of a second pass
// over the geometry -- and the frame it is wrong for is the frame the
// object was hidden in anyway.
bool Fluxion_Cull_WasHidden(Vector3 centre, float radius)
{
  if (cullPyramidParams.w < 0.5) { return false; }

  // The box around the sphere, put on the screen corner by corner. A
  // sphere's outline is not a rectangle, but the rectangle around its box
  // certainly contains it -- and a test that covers MORE screen than the
  // object does can only ever fail to cull, never cull wrongly.
  Vector2 rectMin = Vector2(1.0, 1.0);
  Vector2 rectMax = Vector2(0.0, 0.0);
  float nearest = 1.0;

  for (int corner = 0; corner < 8; corner = corner + 1)
  {
    float ox = radius;
    float oy = radius;
    float oz = radius;
    if (corner == 0 || corner == 1 || corner == 2 || corner == 3) { ox = -radius; }
    if (corner == 0 || corner == 1 || corner == 4 || corner == 5) { oy = -radius; }
    if (corner == 0 || corner == 2 || corner == 4 || corner == 6) { oz = -radius; }

    Vector4 clip = cullPreviousViewProjection * Vector4(centre.x + ox, centre.y + oy, centre.z + oz, 1.0);

    // A corner behind the eye has no place on the screen, and a division
    // by a w at or below zero produces a place that is worse than none.
    // The whole object is left alone.
    if (clip.w <= 0.0) { return false; }

    Vector3 ndc = clip.xyz / clip.w;

    // Clip space runs from -1 to 1 across the screen; a texture is read
    // from 0 to 1.
    Vector2 uv = Vector2(ndc.x * 0.5 + 0.5, ndc.y * 0.5 + 0.5);

    rectMin = min(rectMin, uv);
    rectMax = max(rectMax, uv);
    nearest = min(nearest, ndc.z);
  }

  // Off the screen entirely a frame ago: the frustum test above is what
  // decides that for THIS frame, and guessing from the last one would
  // cull things that have just come into view.
  if (rectMax.x < 0.0 || rectMax.y < 0.0 || rectMin.x > 1.0 || rectMin.y > 1.0) { return false; }

  rectMin = max(rectMin, Vector2(0.0, 0.0));
  rectMax = min(rectMax, Vector2(1.0, 1.0));

  // WHICH LEVEL: the one whose texels are big enough that the rectangle
  // covers about two of them each way, so four reads cover all of it.
  float widthInTexels = (rectMax.x - rectMin.x) * cullPyramidParams.x;
  float heightInTexels = (rectMax.y - rectMin.y) * cullPyramidParams.y;
  float level = ceil(log2(max(max(widthInTexels, heightInTexels), 1.0)));
  level = min(max(level, 0.0), cullPyramidParams.z - 1.0);

  // The four corners of the rectangle at that level, and the FARTHEST of
  // what they hold: the object is hidden only if something was in front
  // of it at every pixel, so one texel that saw further than the object
  // is enough for the object to have been visible.
  float furthest = textureLod(cullPyramid, Vector2(rectMin.x, rectMin.y), level).x;
  furthest = max(furthest, textureLod(cullPyramid, Vector2(rectMax.x, rectMin.y), level).x);
  furthest = max(furthest, textureLod(cullPyramid, Vector2(rectMin.x, rectMax.y), level).x);
  furthest = max(furthest, textureLod(cullPyramid, Vector2(rectMax.x, rectMax.y), level).x);

  return nearest > furthest;
}

bool Fluxion_Cull_InsideFrustum(Vector3 centre, float radius)
{
    // A sphere is outside as soon as it is behind ONE plane. Written out
    // rather than looped, because the planes are separate uniforms:
    // an array of them in a uniform block is packed differently by the
    // two languages, and six named vectors cannot be.
    if (dot(cullPlane0.xyz, centre) + cullPlane0.w < -radius) { return false; }
    if (dot(cullPlane1.xyz, centre) + cullPlane1.w < -radius) { return false; }
    if (dot(cullPlane2.xyz, centre) + cullPlane2.w < -radius) { return false; }
    if (dot(cullPlane3.xyz, centre) + cullPlane3.w < -radius) { return false; }
    if (dot(cullPlane4.xyz, centre) + cullPlane4.w < -radius) { return false; }
    if (dot(cullPlane5.xyz, centre) + cullPlane5.w < -radius) { return false; }
    return true;
}

void main() {
  int index = int(ThreadID);
  if (index >= int(cullCounts.x)) { return; }

  // The layers, answered on the processor -- see the note at the top.
  if (cullLayerPass[index] == 0) { return; }

  Vector4 sphere = cullSpheres[index];
  Vector3 centre = sphere.xyz;
  float radius = sphere.w;

  // An object with no bounds is always drawn: not knowing where
  // something is, is not a reason to decide it is elsewhere. The same
  // rule the processor's answer follows.
  if (radius > 0.0) {
    if (cullEye.w > 0.0) {
      // To the NEAR SIDE of the sphere, not to its centre: a large
      // object whose centre is past the limit may still have half of
      // itself in view.
      float distance = length(centre - cullEye.xyz) - radius;
      if (distance > cullEye.w) { return; }
    }

    if (!Fluxion_Cull_InsideFrustum(centre, radius)) { return; }

    // And whether anything stood in front of it a frame ago.
    if (Fluxion_Cull_WasHidden(centre, radius)) { return; }
  }

  // Seen. Claim a slot in this batch's slice and say which object it is.
  int batch = cullBatches[index];
  int slot = AtomicAdd(cullCommands[batch].instanceCount, 1);
  visibleObjects[cullBatchFirst[batch] + slot] = index;
}

#endif
